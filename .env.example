# PRING-APP local paths
PRING_PROJECT_DIR=../PRING-PACKAGE
PRING_RUNS_DIR=../PRING-PACKAGE/runs
PRING_RUN_DIR=/runs/current
PRING_PACKAGE_SPEC=https://github.com/asmaa-a-abdelwahab/PRING-PACKAGE/archive/refs/heads/main.zip

# Bind published ports to localhost unless a reviewed reverse proxy is used.
PRING_BIND_ADDRESS=127.0.0.1
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
PREDICTOR_PORT=8000
STREAMLIT_PORT=8501

# Replace both values before deployment. Never commit real secrets.
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-password
PREDICTION_API_KEY=replace-with-a-long-random-api-key
NEO4J_DATABASE=neo4j

# Version identity is mandatory with docker-compose.production.yml.
PRING_GRAPH_VERSION=replace-with-run-manifest-or-graph-snapshot-id
PREDICTION_ALLOW_STALE_CACHE=false
PREDICTION_ALLOW_RUNTIME_MISMATCH=false
PREDICTION_REQUIRE_VERIFIED_ARTIFACTS=false
PREDICTION_DEBUG_ERRORS=false

# Safe serving defaults
PREDICTION_SCORE_MODE=auto
PREDICTION_PERSIST_NEW_SCORES=true
PREDICTION_REQUIRE_CACHE_WRITE=true
PREDICTION_PARITY_REQUIRED=true
PREDICTION_ALLOW_STAGE3_FALLBACK=true
PREDICTION_MAX_PAIRS_PER_REQUEST=9

# File-based APOC import/export is disabled unless explicitly required.
NEO4J_APOC_FILE_IMPORT_ENABLED=false
NEO4J_APOC_FILE_EXPORT_ENABLED=false
