# Copy outside the repository, edit, and pass the copy to:
#   bash examples/local/05_full_cyp450_pipeline.sh /secure/path/pring-local.env
# Do not put real secrets in a committed file.

# Directory containing sibling PRING-PACKAGE and PRING-APP repositories.
FRAMEWORK_ROOT=/absolute/path/to/PRING-Framework

# Unique identities for every scientific run. Omit these to use a UTC timestamp.
# PRING_RUN_ID=cyp450_local_20260810
# PRING_READY_RUN_ID=cyp450_local_20260810_ready
# PIPELINE_OUTPUT_ROOT=/data/pring/results/cyp450_local_20260810
PRING_RUN_ROOT=/data/pring/runs
PRING_CACHE_DIR=/data/pring/cache

# Reuse a completed source run to skip collection. It is read, never modified.
PRING_SOURCE_RUN_DIR=

# Python environment. The portable default is CPU; cu124 installs the repository's
# pinned CUDA 12.4 stack. Use profile=none with BOOTSTRAP_ENV=false for an
# already prepared environment.
PRING_VENV=/absolute/path/to/venvs/pring-local
BOOTSTRAP_ENV=true
BOOTSTRAP_TORCH_PROFILE=cpu
MODEL_DEVICE=auto
REQUIRE_CLEAN_GIT=true

# Local resource limits. Leave unset for automatic CPU and 85% RAM detection.
# PRING_CPUS=12
# PRING_MAX_MEMORY_MB=48000
PRING_MEMORY_MARGIN_MB=1024
PRING_SYSTEM_RESERVE_MB=2048

# Prespecified data and label policy. A change defines a different experiment.
PRING_MODE=sparql
PRING_ACTIVITY_THRESHOLD_UM=10
PRING_WEAK_ACTIVITY_AS_NEGATIVE=false
PRING_INCLUDE_SIMILARITY=true
PRING_SIMILARITY_THRESHOLD=90
PRING_INCLUDE_TEXTMINING=false
PRING_INCLUDE_ENDPOINT_REFERENCES=false
PRING_PLUGINS="uniprot go reactome interpro"

# By default the launcher creates a fresh, isolated Neo4j 5.26+GDS container
# and removes only that container and its newly created volume on exit.
LOCAL_NEO4J_MODE=managed
LOCAL_NEO4J_PORT=17687
LOCAL_KEEP_NEO4J=false
LOCAL_NEO4J_IMAGE=neo4j:5.26-community
LOCAL_NEO4J_HEAP_INITIAL=2G
# Leave max heap/page cache unset to scale them from PRING_MAX_MEMORY_MB.
# LOCAL_NEO4J_HEAP_MAX=8G
# LOCAL_NEO4J_PAGECACHE=4G
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# NEO4J_PASSWORD is intentionally omitted; export it or add it only to the
# protected copy outside the repository.

# For an existing dedicated, empty database instead, set:
# LOCAL_NEO4J_MODE=external
# NEO4J_URI=bolt://127.0.0.1:7687

# Complete model set and final validation.
MODEL_STAGE1_CLASSIFIER=extra_trees
MODEL_STAGE2_MODELS="complex distmult rotate"
MODEL_PRIMARY_COMPARE_METRIC=mcc
MODEL_MIN_SPECIFICITY=0.50
MODEL_MIN_RECALL=0.0
MODEL_FINAL_CALIBRATION=platt
MODEL_FINAL_SEEDS="1 2 3 4 5"
MODEL_FINAL_MIN_SEEDS=5
MODEL_FINAL_BOOTSTRAP_RESAMPLES=1000

# Zero means all candidates.
STAGE1_MAX_CANDIDATE_ROWS=0
MODEL_STAGE2_SCORE_BATCH_SIZE=65536

# Optional independent labels for overlap-based external reassessment.
# MODEL_EXTERNAL_LABELS=/absolute/path/to/external_labels.csv
