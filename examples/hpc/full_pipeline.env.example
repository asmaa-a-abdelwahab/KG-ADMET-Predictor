# Copy this file outside the repository, edit it, then:
#   set -a
#   source /secure/path/full_pipeline.env
#   set +a
#   sbatch --export=ALL examples/hpc/04_full_cyp450_pipeline.sbatch
#
# Do not put real secrets in a committed file.

# Directory containing sibling PRING-PACKAGE and PRING-APP checkouts.
FRAMEWORK_ROOT=/home/USER/PRING-Framework

# Prebuilt Python environment. It must contain the PRING package, the
# PRING-APP modeling dependencies, a cluster-compatible PyTorch build, and PyG.
PRING_HPC_VENV=/home/USER/venvs/pring-hpc
BOOTSTRAP_ENV=false
REQUIRE_CLEAN_GIT=true

# Optional cluster modules, space-separated.
HPC_MODULES="python/3.11 cuda/12.4"
PURGE_MODULES=false

# Storage. Prefer project/scratch filesystems rather than a small home quota.
PRING_RUN_ROOT=/scratch/USER/pring/runs
PRING_CACHE_DIR=/scratch/USER/pring/cache
PIPELINE_OUTPUT_ROOT=/scratch/USER/pring/results/cyp450-final

# Leave empty to collect a new uncapped five-CYP run. To avoid network access
# on compute nodes, point this at an existing completed PRING run.
PRING_SOURCE_RUN_DIR=
PRING_RUN_ID=cyp450_5enzymes_final
PRING_READY_RUN_ID=cyp450_5enzymes_final_ready

# Prespecified data/label policy. Any change defines a different experiment.
PRING_MODE=sparql
PRING_ACTIVITY_THRESHOLD_UM=10
PRING_WEAK_ACTIVITY_AS_NEGATIVE=true
PRING_INCLUDE_SIMILARITY=true
PRING_SIMILARITY_THRESHOLD=90
PRING_INCLUDE_TEXTMINING=false
PRING_PLUGINS="uniprot go reactome interpro"

# Neo4j with the Graph Data Science plugin. Inject NEO4J_PASSWORD through a
# scheduler secret or secret manager, not this example file.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
# NEO4J_PASSWORD is intentionally omitted.
ALLOW_NONEMPTY_NEO4J=false

# Modeling. Use CPU only for a deliberately bounded smoke run.
MODEL_DEVICE=cuda
MODEL_STAGE1_DEVICE=cuda
MODEL_STAGE2_DEVICE=cuda
MODEL_STAGE3_DEVICE=cuda
MODEL_STAGE1_CLASSIFIER=extra_trees
MODEL_STAGE2_MODELS="complex distmult rotate"
MODEL_PRIMARY_COMPARE_METRIC=mcc
MODEL_MIN_SPECIFICITY=0.50
MODEL_MIN_RECALL=0.0
MODEL_FINAL_CALIBRATION=platt
MODEL_FINAL_SEEDS="1 2 3 4 5"
MODEL_FINAL_BOOTSTRAP_RESAMPLES=1000

# Full candidate exports can be large. Zero means all rows.
STAGE1_MAX_CANDIDATE_ROWS=0
MODEL_STAGE2_SCORE_BATCH_SIZE=65536

# The workflow refuses existing ready-run and output directories. Use new
# identifiers for every scientific run rather than overwriting or resuming one.
