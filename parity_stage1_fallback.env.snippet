# Keep strict component-level parity validation enabled.
PREDICTION_PARITY_REQUIRED=true
PREDICTION_PARITY_SAMPLE_SIZE=5
PREDICTION_PARITY_MAE_MAX=0.05
PREDICTION_PARITY_MAX_ABS_ERROR=0.15
PREDICTION_PARITY_SPEARMAN_MIN=0.90
PREDICTION_PARITY_DECISION_AGREEMENT_MIN=0.95

# Permit the separately validated R-GCN + HGT fallback when Stage 1 cannot be
# reproduced but both Stage 3 components pass parity.
PREDICTION_ALLOW_STAGE3_FALLBACK=true
STAGE3_FALLBACK_MODEL_FILE=/models/production/production_stage3_fallback.joblib
STAGE3_FALLBACK_MANIFEST_FILE=/models/production/stage3_fallback_manifest.json

# Prefer exact training-time Stage 1 pair features. The directory may contain:
# - compound_target_training_pairs_gds_features.csv
# - candidate_pairs_gds_features.csv
STAGE1_PAIR_FEATURE_DIR=/modeling_prepared/stage1_neo4j_gds_baselines
# Optional explicit file(s). On Linux separate multiple paths with ':';
# leave empty when using STAGE1_PAIR_FEATURE_DIR.
STAGE1_PAIR_FEATURE_FRAME=

# Retain the Neo4j embedding path only as a diagnostic fallback. It is accepted
# for primary live serving only when it passes parity.
STAGE1_EMBEDDING_PROPERTY=pringFastRP
