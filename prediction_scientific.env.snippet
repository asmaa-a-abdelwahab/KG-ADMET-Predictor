# Lookup order: immutable validated frame -> production cache -> live inference.
PREDICTION_SCORE_MODE=auto
PREDICTION_PERSIST_NEW_SCORES=true
PREDICTION_REQUIRE_CACHE_WRITE=true

# New live predictions are written here, not to finalized_training_frame.csv.
PREDICTION_CACHE_FRAME=/results/production/production_prediction_cache.csv

# Guard live inference with parity testing against validated component scores.
PREDICTION_PARITY_REQUIRED=true
PREDICTION_PARITY_SAMPLE_SIZE=5
PREDICTION_PARITY_MAE_MAX=0.05
PREDICTION_PARITY_MAX_ABS_ERROR=0.15
PREDICTION_PARITY_SPEARMAN_MIN=0.90
PREDICTION_PARITY_DECISION_AGREEMENT_MIN=0.95

# Target-conditioned explanation and applicability-domain settings.
PREDICTION_TARGET_BACKGROUND_MIN_ROWS=20
PREDICTION_LOCAL_IMPORTANCE_MIN_EFFECT=0.01
PRING_GRAPH_VERSION=cyp450_5enzymes_uncapped_raw_rematerialized

# Keep only one large Stage 3 checkpoint resident at a time.
PREDICTION_UNLOAD_STAGE3_AFTER_SCORE=true
PREDICTION_UNLOAD_SHARED_GRAPH_AFTER_SCORE=false
PREDICTION_STAGE3_BATCH_SIZE=1

PREDICTION_ENABLE_TREE_SHAP=false
PREDICTION_MAX_PAIRS=9
PREDICTION_MAX_PAIRS_PER_REQUEST=9
PREDICTION_TIMEOUT_SECONDS=1800
PREDICTION_CPU_THREADS=4
MALLOC_ARENA_MAX=2

# Required live artifacts.
MODEL_PREPARED_DIR=./artifacts/modeling_prepared
STAGE3_PREPARED_DIR=/modeling_prepared
STAGE1_MODEL_DIR=/models/improved_v2/stage1_gds_extra_trees
RGCN_MODEL_DIR=/models/improved_v2/stage3_rgcn_sampled
HGT_MODEL_DIR=/models/improved_v2/stage3_hgt_sampled
STAGE1_EMBEDDING_PROPERTY=pringFastRP
