FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MALLOC_ARENA_MAX=1

WORKDIR /opt/kg

COPY modeling/pring_modeling /opt/kg/pring_modeling
COPY modeling/scripts/validate_prediction_assets.py /opt/kg/validate_prediction_assets.py

RUN python -m pip install --upgrade pip \
    && python -m pip install \
      "pandas>=2.1,<3.0" \
      "numpy>=1.24,<3.0" \
      "scikit-learn==1.8.0" \
      "joblib>=1.3,<2.0" \
      "neo4j>=5.20,<7.0" \
      "fastapi>=0.115,<1.0" \
      "uvicorn[standard]>=0.30,<1.0" \
      "pydantic>=2.0,<3.0"

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /opt/kg

USER appuser
EXPOSE 8000

CMD [
  "python", "-m", "uvicorn",
  "pring_modeling.prediction_api:app",
  "--host", "0.0.0.0",
  "--port", "8000",
  "--workers", "1",
  "--timeout-keep-alive", "10"
]
